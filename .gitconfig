[core]
    ignorecase = false
    # global ignore, linked from git/gitignore.global. was an absolute linux
    # path (/home/mydn8y/...), which silently did nothing on macOS.
    excludesfile = ~/.gitignore

[color]
    ui = true

[push]
    default = current

[rebase]
    autosquash = true

[log]
    abbrevCommit = true

[alias]
    pop = stash pop
    pp = "!git pull origin $(git branch --show-current) --rebase"
    pmm = "!git pull origin main --rebase"
    pm = "!git pull origin master --rebase"
    ap = add -p
    s = status -sb
    d = diff -w
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'

[gpg]
    program = gpg
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[difftool]
	prompt = false
[rerere]
	enabled = true

# identity lives here instead of above, because the email differs between work
# and personal machines and the signing key is per-keyring — so it can't be
# committed. written by install/bootstrap/github.sh. the trailing include wins
# over anything set earlier in this file.
[include]
    path = ~/.gitconfig.local
