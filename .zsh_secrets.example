# template for ~/.zsh_secrets — copy, fill in, and never commit the real file
#
#   cp .zsh_secrets.example ~/.zsh_secrets && chmod 600 ~/.zsh_secrets
#
# sourced from .zshrc only if it exists, so a machine without these still boots.

# packagecloud (npm registry auth)
export PACKAGECLOUD_NPM_TOKEN=
export PACKAGECLOUD_TOKEN=

# nexus registry auth
export GSL_NEXUS_REGISTRY_TOKEN=
