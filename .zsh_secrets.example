# template for .zsh_secrets — the real file lives next to this one in the repo,
# gitignored, and `make link` symlinks it to ~/.zsh_secrets.
#
# `make terminal-zsh` seeds it from this template if it doesn't exist yet, so
# there's normally nothing to copy by hand.
#
# .zshrc sources it only if it exists, so a machine without it still boots.

# slack member id. not a credential, but it identifies an account and differs
# between a work and a personal machine, so it doesn't belong in .zshrc.
export SLACK_USERID=
